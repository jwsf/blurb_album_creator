# macOS
.DS_Store

# Working output directory
outputs/

# Track inputs/ directory, but ignore all image content
inputs/**
!inputs/.gitkeep

# Template .blurb files are not distributed — download from blurb.com/templates
references/templates/*.blurb
references/templates/*.blurb-shm
references/templates/*.blurb-wal
references/*.blurb
references/*.pdf
references/test_samples/

# SQLite journal files (WAL mode)
*.blurb-shm
*.blurb-wal

# Python
__pycache__/
*.pyc

# Image batcher state
/tmp/image_batcher_state.json

# Blurb creation memory
/tmp/blurb_last_create_options.json

# Local machine/user Claude settings
.claude/settings.local.json
